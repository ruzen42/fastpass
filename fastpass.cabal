cabal-version:      3.0

name:               fastpass
version:            0.1.1.2
synopsis:           simple passwords generation program
description:        simple passwords generation program
homepage:           https://github.com/ruzen42/fastpass
license:            BSD-3-Clause
license-file:       LICENSE
author:             ruzen42
maintainer:         ruzen@tuta.io
copyright:          "2025 Ruzen42"
category:           System
build-type:         Simple
extra-doc-files:    CHANGELOG.md

source-repository head
  type: git
  location: https://github.com/ruzen42/imageConverter

common warnings
    ghc-options: -Wall -O2

library
  exposed-modules:
    RandomGenerator
  hs-source-dirs:
      src
  ghc-options: -Wall -Wcompat -Widentities -Wincomplete-record-updates -Wincomplete-uni-patterns -Wmissing-export-lists -Wmissing-home-modules -Wpartial-fields -Wredundant-constraints -O2
  build-depends: base >=4.18.2.1
               , tasty >= 1.5.3
               , parallel
               , random >= 1.2.1.3
               , text
  default-language: GHC2021

executable fastpass
    import:           warnings
    main-is:          Main.hs
    build-depends:    base >=4.18.2.1
                    , tasty >= 1.5.3
                    , async
                    , optparse-applicative >=0.18.1.0 && <= 0.19.0.0
                    , fastpass
                    , text
    hs-source-dirs:   app
    default-language: GHC2021


